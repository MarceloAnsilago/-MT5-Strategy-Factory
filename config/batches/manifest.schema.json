{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "policy": {
      "const": {
        "simulation_default": true,
        "environment": "strategy_tester",
        "optimization": false,
        "forward_mode": 0,
        "local_agents_only": true,
        "allow_live_trading": false,
        "automatic_retries": false
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts_per_test": {
          "type": "integer",
          "minimum": 1
        },
        "max_backtests": {
          "type": "integer",
          "minimum": 1
        },
        "max_concurrency": {
          "const": 1
        },
        "max_run_artifact_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_strategies": {
          "type": "integer",
          "minimum": 1
        },
        "min_free_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "timeout_batch_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_per_test_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_artifact_bytes",
        "max_attempts_per_test",
        "max_backtests",
        "max_concurrency",
        "max_run_artifact_bytes",
        "max_strategies",
        "min_free_disk_bytes",
        "timeout_batch_seconds",
        "timeout_per_test_seconds"
      ],
      "additionalProperties": false
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "ea": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "\\.[eE][xX]5$"
              },
              "compiled_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              },
              "source_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "compiled_sha256",
              "source_sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "strategy_id",
          "version",
          "ea"
        ],
        "additionalProperties": false
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "strategy_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "deposit": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "execution_delay": {
                "type": "integer",
                "minimum": -1,
                "maximum": 600000
              },
              "from_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "leverage": {
                "type": "integer",
                "minimum": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              },
              "timeframe": {
                "type": "string",
                "minLength": 1
              },
              "to_date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "currency",
              "deposit",
              "execution_delay",
              "from_date",
              "leverage",
              "model",
              "symbol",
              "timeframe",
              "to_date"
            ],
            "additionalProperties": false
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "run_id",
          "strategy_id",
          "parameters",
          "inputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "batch_id",
    "revision",
    "policy",
    "budget",
    "strategies",
    "runs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MT5 Strategy Factory batch manifest 1.0"
}